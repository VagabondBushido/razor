# App URL for payment redirect (change in production)
APP_URL=http://localhost:5173

# Razorpay keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_key

# Course price in paise (100 paise = ₹1). Example: 49900 = ₹499
COURSE_AMOUNT=49900

# WhatsApp group invite link
VITE_WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-group-invite-link

# Webinar details (shown on landing page)
VITE_COURSE_NAME=Crypto Education Webinar
VITE_COURSE_PRICE=499
VITE_WEBINAR_DATE=[DATE]
VITE_WEBINAR_TIME=[TIME]
